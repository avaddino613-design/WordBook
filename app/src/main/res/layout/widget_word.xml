<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="10dp"
        android:paddingEnd="18dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/w_word"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="34dp"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="Luminous"
            android:textColor="#FF6B57"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_pos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="serif"
            android:maxLines="1"
            android:text="adjective"
            android:textColor="#7BA3FF"
            android:textSize="15sp"
            android:textStyle="italic" />

        <TextView
            android:id="@+id/w_meaning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:fontFamily="serif"
            android:maxLines="4"
            android:text="Giving off light; bright or glowing."
            android:textColor="#ECEEF4"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/w_example"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:fontFamily="serif"
            android:maxLines="2"
            android:textColor="#98A0B5"
            android:textSize="13sp"
            android:textStyle="italic"
            android:visibility="gone" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/w_shuffle"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:layout_margin="6dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/shuffle"
        android:padding="9dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_shuffle" />
</FrameLayout>
